rules_version = '2';

// Regras do Cloud Firestore (plano gratuito Spark).
// Cole no Console do Firebase > Firestore Database > Regras > Publicar.
// Cada aparelho entra com login anônimo e só lê/cria as próprias sessões.
// Sessões não podem ser alteradas nem apagadas pelo app.
service cloud.firestore {
  match /databases/{database}/documents {

    match /sessions/{sessionId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['sessionId', 'uid', 'goal', 'mode', 'startedAt', 'endedAt', 'endReason', 'completed', 'steps', 'savedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sessionId == sessionId
        && request.resource.data.goal is string
        && request.resource.data.goal.size() > 0
        && request.resource.data.goal.size() <= 500
        && request.resource.data.mode in ['mock', 'real']
        && request.resource.data.completed is bool
        && request.resource.data.steps is list
        && request.resource.data.steps.size() <= 100;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

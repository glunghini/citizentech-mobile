# Copie este arquivo para ".env" e preencha. O ".env" NÃO vai para o GitHub.
# Variáveis EXPO_PUBLIC_* ficam dentro do APK: nunca coloque aqui chave do Gemini,
# senha de banco ou qualquer segredo de servidor.

# Origem das orientações: "mock" (respostas simuladas no próprio celular) ou "real" (API HTTP).
EXPO_PUBLIC_GUIDANCE_MODE=mock

# Raiz do servidor, SEM /api/v1. Só é usada no modo "real".
# Celular físico + API no computador: use o IP do computador na mesma rede Wi-Fi (não use localhost).
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:5000

# Endereço da página de demonstração (opcional). Ex.: GitHub Pages do repositório.
EXPO_PUBLIC_DEMO_URL=https://SEU-USUARIO.github.io/SEU-REPOSITORIO/demo/

# Firebase (plano gratuito Spark). Console do Firebase > Configurações do projeto > Seus apps > App da Web.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
